# Configuração do Google Drive — feita UMA VEZ por quem publica o site.
#
# Copie este arquivo para `.env` (que o git ignora) para usar o Drive em
# desenvolvimento. Na publicação, os mesmos nomes entram em
# Settings → Secrets and variables → Actions → Variables, no GitHub.
#
# Nada aqui é senha: o ID do cliente OAuth é público por natureza (aparece na
# barra de endereços em qualquer login com Google). Quem protege a conta é a
# lista de origens autorizadas no Google Cloud. O passo a passo está no
# LEIA-ME, em "Google Drive".

VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Opcionais: sem eles o seletor de arquivos abre do mesmo jeito.
# VITE_GOOGLE_API_KEY=
# VITE_GOOGLE_APP_ID=
